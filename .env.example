# ─── App ────────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ─── Fiserv ITD ─────────────────────────────────────────────────────────────
# URL base del servicio ITD (solicitar a Fiserv)
ITD_BASE_URL=https://itd-sandbox.fiserv.com

# POS ID del terminal asignado por Fiserv
ITD_POS_ID=15600526

# System ID asignado al cliente por Fiserv (pendiente)
ITD_SYSTEM_ID=PENDING

# Identificadores de la aplicación (configurar por sucursal si aplica)
ITD_BRANCH=SUCURSAL-1
ITD_CLIENT_APP_ID=LOGFOOD-POS

# Timeout para llamadas HTTP al ITD (ms)
ITD_TIMEOUT_MS=15000

# ─── CORS ────────────────────────────────────────────────────────────────────
# URL del frontend POS
CORS_ORIGIN=http://localhost:5174

# ─── Caller ID / llamadas entrantes ─────────────────────────────────────────
# Clave que debe enviar el capturador local (o el simulador de dev de la UI) en el
# header X-Agent-Key para poder hacer POST /api/incoming-calls. Generar un valor
# random largo (ej: openssl rand -hex 32) y NO commitearlo.
AGENT_API_KEY=

# ─── Feature flags ───────────────────────────────────────────────────────────
# Todas en false por default: permite liberar una v1 "solo gestión" (catálogo,
# proveedores, órdenes de compra, facturas de proveedores, stock) sin tocar código.
# Se validan al arrancar (ver src/config/env.validation.ts): combinaciones inválidas
# hacen que el servidor no levante, con un mensaje explicando qué falta.

# App POS (login POS, pantalla de ventas) + creación/gestión/anulación de ventas.
FEATURE_POS=false

# Sesiones y movimientos de caja (abrir/cerrar caja, ingresos/egresos manuales).
# Requiere FEATURE_POS=true (las ventas necesitan una sesión de caja abierta).
FEATURE_CASH=false

# Llamadas entrantes (caller ID): módulo `calls`, gateway de sockets, panel del POS
# y simulador de dev. Requiere FEATURE_POS=true y FEATURE_CUSTOMERS=true.
FEATURE_CALLS=false

# Clientes y repartidores (CRUD + asociarlos a una venta).
FEATURE_CUSTOMERS=false

# Reportes/dashboard con datos de ventas (serie histórica, por producto, por
# repartidor). Requiere FEATURE_POS=true.
FEATURE_SALES_REPORTS=false

# true para clientes gastronómicos: recetas, costo por plato, margen. Sin dependencias
# con los demás flags.
FEATURE_RECIPES=false
