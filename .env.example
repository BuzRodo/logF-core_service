# ─── App ────────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ─── Fiserv ITD ─────────────────────────────────────────────────────────────
# URL base del servicio ITD (solicitar a Fiserv)
ITD_BASE_URL=https://itd-sandbox.fiserv.com

# POS ID del terminal asignado por Fiserv
ITD_POS_ID=15600526

# System ID asignado al cliente por Fiserv (pendiente)
ITD_SYSTEM_ID=PENDING

# Identificadores de la aplicación (configurar por sucursal si aplica)
ITD_BRANCH=SUCURSAL-1
ITD_CLIENT_APP_ID=LOGFOOD-POS

# Timeout para llamadas HTTP al ITD (ms)
ITD_TIMEOUT_MS=15000

# ─── CORS ────────────────────────────────────────────────────────────────────
# URL del frontend POS
CORS_ORIGIN=http://localhost:5174
